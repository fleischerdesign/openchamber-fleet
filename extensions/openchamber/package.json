{
  "name": "@fleischerdesign/openchamber-fleet-extension",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.8.0"
    },
    "id": "openchamber-fleet",
    "name": "Fleet",
    "icon": "server",
    "contributes": {
      "panel": {
        "entry": "panel/index.html",
        "mobile": true
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true,
        "permissions": {
          "exec": [
            "ssh",
            "git"
          ]
        }
      },
      "statusSection": {
        "source": {
          "path": "/status-view",
          "interval": 10000
        },
        "title": "Fleet",
        "height": 140
      },
      "opencodePlugin": "plugin",
      "tools": [
        {
          "match": "fleet_status",
          "name": "Fleet status",
          "icon": "server",
          "title": "Fleet status · {input.host}",
          "output": "card",
          "card": {
            "label": "{output.host}",
            "title": "{output.statusLabel}",
            "status": {
              "value": "{output.statusLabel}",
              "tones": {
                "Ready": "success",
                "Not synced": "warning",
                "Recovery needed": "error"
              }
            },
            "fields": [
              { "label": "Workspace", "value": "{output.workspace}" },
              { "label": "Next step", "value": "{output.nextStep}" }
            ]
          }
        },
        {
          "match": "fleet_sync",
          "name": "Fleet sync",
          "icon": "git-commit",
          "title": "Fleet sync · {input.host}",
          "subtitle": "{output.changes} change(s) · {output.modeLabel}",
          "output": "table",
          "columns": ["action", "path"]
        },
        {
          "match": "fleet_exec",
          "name": "Fleet exec",
          "icon": "terminal",
          "title": "Fleet exec · {input.host}",
          "subtitle": "{output.stateLabel} · job {output.jobId}",
          "output": "card",
          "card": {
            "label": "{output.host}",
            "title": "{output.commandLabel}",
            "status": {
              "value": "{output.stateLabel}",
              "tones": {
                "Queued": "info",
                "Starting": "info",
                "Running": "info",
                "Succeeded": "success",
                "Failed": "error",
                "Cancelled": "warning",
                "Unknown": "error",
                "Interrupted": "error"
              }
            },
            "fields": [
              { "label": "Exit", "value": "{output.exitLabel}" },
              { "label": "Mode", "value": "{output.modeLabel}" }
            ]
          }
        },
        {
          "match": "fleet_run",
          "name": "Fleet run",
          "icon": "play",
          "title": "Fleet run · {output.host}",
          "subtitle": "{output.syncLabel} · {output.stateLabel}",
          "output": "card",
          "card": {
            "label": "{output.host}",
            "title": "{output.commandLabel}",
            "status": {
              "value": "{output.stateLabel}",
              "tones": {
                "Queued": "info",
                "Starting": "info",
                "Running": "info",
                "Succeeded": "success",
                "Failed": "error",
                "Cancelled": "warning",
                "Sync required": "warning",
                "Unknown": "error",
                "Interrupted": "error"
              }
            },
            "fields": [
              { "label": "Sync", "value": "{output.syncLabel}" },
              { "label": "Exit", "value": "{output.exitLabel}" },
              { "label": "Mode", "value": "{output.modeLabel}" }
            ]
          }
        },
        {
          "match": "fleet_hosts",
          "name": "Fleet hosts",
          "icon": "server",
          "title": "Fleet hosts · {output.workspace}",
          "output": "table",
          "columns": ["alias", "tagsLabel"]
        },
        {
          "match": "fleet_jobs",
          "name": "Fleet jobs",
          "icon": "time",
          "title": "Fleet jobs",
          "output": "table",
          "columns": ["host", "commandLabel", "stateLabel", "runLabel", "exitLabel"]
        },
        {
          "match": "fleet_fetch",
          "name": "Fleet fetch",
          "icon": "download",
          "title": "Fleet fetch · {input.host}",
          "output": "card",
          "card": {
            "label": "{output.artifact}",
            "title": "{output.file}",
            "status": {
              "value": "{output.statusLabel}",
              "tones": {
                "Verified": "success"
              }
            },
            "fields": [
              { "label": "Size", "value": "{output.bytes} bytes" },
              { "label": "SHA-256", "value": "{output.digest}" }
            ]
          }
        },
        {
          "match": "fleet_upload",
          "name": "Fleet upload",
          "icon": "upload",
          "title": "Fleet upload · {input.host}",
          "subtitle": "{output.bytes} bytes · {output.statusLabel}",
          "output": "table",
          "columns": ["source", "destination", "digest"]
        },
        {
          "match": "fleet_download",
          "name": "Fleet download",
          "icon": "download",
          "title": "Fleet download · {input.host}",
          "output": "card",
          "card": {
            "label": "{output.source}",
            "title": "{output.file}",
            "status": {
              "value": "{output.statusLabel}",
              "tones": {
                "Verified": "success"
              }
            },
            "fields": [
              { "label": "Target", "value": "{output.target}" },
              { "label": "Size", "value": "{output.bytes} bytes" },
              { "label": "SHA-256", "value": "{output.digest}" }
            ]
          }
        },
        {
          "match": "fleet_job_status",
          "name": "Fleet job",
          "icon": "time",
          "title": "Fleet job · {input.host}",
          "subtitle": "{output.stateLabel} · {output.jobId}",
          "output": "card",
          "card": {
            "label": "{output.host}",
            "title": "{output.stateLabel}",
            "status": {
              "value": "{output.stateLabel}",
              "tones": {
                "Queued": "info",
                "Starting": "info",
                "Running": "info",
                "Cancelling": "warning",
                "Succeeded": "success",
                "Failed": "error",
                "Cancelled": "warning",
                "Unknown": "error",
                "Interrupted": "error"
              }
            },
            "fields": [
              { "label": "Run", "value": "{output.runLabel}" },
              { "label": "Exit", "value": "{output.exitLabel}" },
              { "label": "stdout", "value": "{output.stdoutBytes} bytes" },
              { "label": "stderr", "value": "{output.stderrBytes} bytes" }
            ]
          }
        },
        {
          "match": "fleet_job_cancel",
          "name": "Fleet job cancel",
          "icon": "close-circle",
          "title": "Fleet cancel · {input.host}",
          "subtitle": "{output.stateLabel} · {output.jobId}",
          "output": "card",
          "card": {
            "label": "{output.host}",
            "title": "{output.stateLabel}",
            "status": {
              "value": "{output.stateLabel}",
              "tones": {
                "Queued": "info",
                "Starting": "info",
                "Running": "info",
                "Cancelling": "warning",
                "Cancelled": "warning",
                "Succeeded": "success",
                "Failed": "error",
                "Interrupted": "error",
                "Unknown": "error"
              }
            },
            "fields": [
              { "label": "Run", "value": "{output.runLabel}" },
              { "label": "Exit", "value": "{output.exitLabel}" }
            ]
          }
        },
        {
          "match": "fleet_recover",
          "name": "Fleet recovery",
          "icon": "refresh",
          "title": "Fleet recovery · {input.host}",
          "output": "card",
          "card": {
            "label": "{output.host}",
            "title": "{output.resultLabel}",
            "status": {
              "value": "{output.resultLabel}",
              "tones": {
                "Recovered": "success",
                "Recovery aborted": "warning",
                "Nothing to recover": "info",
                "Recovery still needed": "error"
              }
            },
            "fields": [
              { "label": "Next step", "value": "{output.nextStep}" }
            ]
          }
        }
      ]
    }
  }
}
