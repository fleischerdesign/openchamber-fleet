{
  "name": "openchamber-fleet",
  "version": "0.7.0",
  "description": "Replicate a workspace to a remote machine and run one command there — for OpenCode and OpenChamber agents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fleet": "bin/fleet.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "extensions/openchamber",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.extension.json && node scripts/build-extension.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.extension.json",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleischerdesign/openchamber-fleet.git"
  },
  "homepage": "https://github.com/fleischerdesign/openchamber-fleet#readme",
  "bugs": {
    "url": "https://github.com/fleischerdesign/openchamber-fleet/issues"
  },
  "keywords": [
    "opencode",
    "openchamber",
    "remote",
    "rsync",
    "ssh",
    "agents"
  ],
  "devDependencies": {
    "@openchamber/sdk": "^2.8.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^7.0.0"
  }
}
